# Archivo: .env.production
# CONFIGURACIÓN PARA PRODUCCIÓN
# ⚠️ IMPORTANTE: Cambiar todos los valores por defecto con contraseñas seguras

NODE_ENV=production
APP_PORT=3000
LOG_LEVEL=info

# Base de Datos - MySQL
DB_HOST=db
DB_PORT=3306
DB_USERNAME=ghv_app_user
DB_PASSWORD=your_very_secure_password_here_min_32_chars
DB_DATABASE=gestor_hojas_de_vida
DB_ROOT_PASSWORD=root_very_secure_password_min_32_chars
DB_SYNC=false
DB_LOGGING=false

# JWT - Autenticación
JWT_SECRET=your_jwt_secret_key_min_32_characters_long
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_char

# Aplicación
APP_NAME=Gestor Hojas de Vida
APP_VERSION=1.0.0
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Archivos
MAX_FILE_SIZE_MB=50
UPLOAD_PATH=./uploads

# Seguridad
CORS_ORIGIN=https://yourdomain.com
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
